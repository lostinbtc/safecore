<!-- Adaptive layers are enlarged by Android before the launcher applies its
     mask. Relative insets keep the entire globe inside the safe zone at every
     rendered icon size; fixed dp padding can crop larger list/recents icons. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="20%" android:insetTop="20%"
    android:insetRight="20%" android:insetBottom="20%">
    <bitmap android:src="@drawable/safecore_logo" android:gravity="fill" android:filter="true" />
</inset>
